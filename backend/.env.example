# ─── Server ────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=production
LOG_LEVEL=info

# ─── Redis ─────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# ─── PSX Data Sources ──────────────────────────────────────────────────
# PSX DPS API (primary - fastest, most accurate)
PSX_DPS_BASE_URL=https://dps.psx.com.pk
PSX_MARKET_WATCH_URL=https://dps.psx.com.pk/market-watch
PSX_SYMBOLS_URL=https://dps.psx.com.pk/symbols
PSX_TIMESERIES_URL=https://dps.psx.com.pk/timeseries/int

# PSX Official site (Playwright scraping fallback)
PSX_WEB_URL=https://www.psx.com.pk/market-watch

# ─── Scraper Config ────────────────────────────────────────────────────
# Primary polling interval (ms) - 2s for DPS API
SCRAPER_POLL_INTERVAL=2000
# Playwright page refresh interval (ms)
PLAYWRIGHT_REFRESH_INTERVAL=1500
# Max concurrent browser pages
PLAYWRIGHT_MAX_PAGES=2
# Browser timeout (ms)
BROWSER_TIMEOUT=30000
# Enable Playwright (false = API-only mode)
ENABLE_PLAYWRIGHT=true

# ─── WebSocket ─────────────────────────────────────────────────────────
WS_HEARTBEAT_INTERVAL=15000
WS_MAX_PAYLOAD=524288

# ─── Tick History ──────────────────────────────────────────────────────
# Max ticks to retain per symbol in memory
MAX_TICKS_PER_SYMBOL=1440
# Candle intervals (seconds)
CANDLE_INTERVALS=60,300,900,3600

# ─── Market Session (PKT = UTC+5) ─────────────────────────────────────
MARKET_OPEN_HOUR=9
MARKET_OPEN_MINUTE=30
MARKET_CLOSE_HOUR=15
MARKET_CLOSE_MINUTE=30
MARKET_TIMEZONE=Asia/Karachi

# ─── Health & Monitoring ───────────────────────────────────────────────
HEALTH_CHECK_INTERVAL=30000
STALE_DATA_THRESHOLD=30000
WATCHDOG_INTERVAL=60000

# ─── CORS ──────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
