{
  "version": 2,
  "builds": [
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    { "src": "/(.*)", "dest": "frontend/dist/$1" }
  ],
  "env": {
    "VITE_API_URL": "https://ai-psx-indicator-1.onrender.com/api",
    "VITE_WS_URL": "wss://ai-psx-indicator-1.onrender.com"
  }
}
